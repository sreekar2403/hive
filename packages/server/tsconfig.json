{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@hive/shared": ["../shared/src"],
      "@hive/shared/*": ["../shared/src/*"]
    },
    "composite": true
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }]
}
